# ============================================================
# SAKARIA REPAIR MANAGER - Environment Configuration Template
# ============================================================

# Network & Environment
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://sakariacade.github.io

# JWT Security
# Generate a strong 64-char key: openssl rand -hex 64
JWT_SECRET=generate_a_secure_64_character_random_hex_key_here
JWT_EXPIRES_IN=8h

# Persistent Storage (SQLite & Backups)
# For Render hosting: use /var/data (mounted via persistent disk)
# For local development: use ./data/sakaria.db
DB_PATH=./data/sakaria.db
BACKUP_DIR=./data/backups

# Default Admin Credentials (must change on first login)
ADMIN_DEFAULT_PASSWORD=Admin@Sakaria2026

# GitHub Cloud Auto-Backup & Restore (Optional)
# ------------------------------------------------------------
# Minimal Required PAT Permissions (Amni: Oggolaanshaha ugu yar):
# Fine-grained Personal Access Token:
#   1. Repository access: 'Only select repositories' -> 'sakaria-repair-manager'
#   2. Repository permissions: 'Contents' -> Read and Write
#   3. Zero other scopes required (No admin, no workflow, no user scopes)
# Classic PAT:
#   'repo' (or 'public_repo' if repository is public)
# ------------------------------------------------------------
GITHUB_TOKEN=your_minimal_scope_github_token_here
GITHUB_REPO_OWNER=sakariacade
GITHUB_REPO_NAME=sakaria-repair-manager
